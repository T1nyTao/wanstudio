<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>MediaCheck</RootNamespace>
    <AssemblyName>media-check</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsPackageType>None</WindowsPackageType>
    <UseWinUI>false</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- 只是本机验证工具，不参与发布 -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <!--
    直接吃 WanStudio 的 Media 源码，不引用 WinUI 工程：
    这样能独立证明 Media 层（契约/ffmpeg/WinRT/定位器/切段）本身可编译、可运行。
  -->
  <ItemGroup>
    <Compile Include="..\..\WanStudio\Services\Media\*.cs" LinkBase="Media" />
  </ItemGroup>

</Project>
