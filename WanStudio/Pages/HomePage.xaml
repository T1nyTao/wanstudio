<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WanStudio.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WanStudio.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        新建视频页。排版遵循 App 级设计令牌（Styles/DesignSystem.xaml）。
        视觉优先序：模式、提示词、参考素材、素材库（视频）、参数、续接、主操作。

        元素顺序约束（历史教训）：
        ClipBinPanel（Bin）必须在 MediaPanel 的闭合标签之后、作为兄弟节点存在。
        之前把它插进 MediaPanel 内部的 DataTemplate 里，把模板切碎了，
        导致 x:Name="Bin" 编译器解析不到（CS0103）。改这个文件时注意层级。
    -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource Space5}"
                    HorizontalAlignment="Stretch">

            <StackPanel Style="{StaticResource PageHeader}">
                <TextBlock Style="{StaticResource DisplayText}" Text="新建视频" />
                <TextBlock Style="{StaticResource BodyText}"
                           Text="选模式、写提示词、准备素材。缺 Key 或素材不齐时，生成按钮会禁用并写明原因。" />
            </StackPanel>

            <!-- 生成方式 -->
            <StackPanel Spacing="{StaticResource Space3}">
                <TextBlock Style="{StaticResource CaptionText}" Text="生成方式" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                    <Button x:Name="ModeTextBtn" Content="文生视频" Click="ModeButton_Click" Tag="TextToVideo" />
                    <Button x:Name="ModeImageBtn" Content="图生视频" Click="ModeButton_Click" Tag="ImageToVideo" />
                    <Button x:Name="ModeCharBtn" Content="人物替换" Click="ModeButton_Click" Tag="CharacterReplace" />
                    <Button x:Name="ModeMotionBtn" Content="动作参考" Click="ModeButton_Click" Tag="MotionReference" />
                </StackPanel>
                <TextBlock x:Name="ModeHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 提示词 -->
            <TextBox x:Name="PromptBox" Header="提示词" AcceptsReturn="True"
                     TextWrapping="Wrap" MinHeight="112"
                     PlaceholderText="描述画面、主体与镜头运动"
                     TextChanged="PromptBox_TextChanged" />

            <!-- 参考素材（图 / 音色）：按模式显示 -->
            <Border x:Name="MediaPanel" Style="{StaticResource Card}">
                <StackPanel Spacing="{StaticResource Space4}">

                    <Grid ColumnSpacing="{StaticResource Space3}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MediaLabel" Style="{StaticResource SectionTitle}"
                                   FontSize="16" Text="素材" VerticalAlignment="Center" />
                        <TextBlock x:Name="MediaCountText" Grid.Column="1" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Text="" />
                    </Grid>

                    <!-- 参考图（多人 = 多张） -->
                    <StackPanel x:Name="RefImagePanel" Spacing="{StaticResource Space2}">
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="参考图：多人就多加几张，每张只放一个角色。" />
                        <TextBlock Style="{StaticResource CaptionText}" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Text="提示词里必须用「图1」「视频1」指代素材，否则模型不知道要对谁做什么。" />
                        <ListView x:Name="RefImageList" MaxHeight="156" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="{StaticResource Space2}" Padding="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="72" Height="40" CornerRadius="{StaticResource RadiusControl}"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" Content="移除" FontSize="12"
                                                Tag="{Binding Index}" Click="RemoveRefImage_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                            <Button x:Name="PickPrimaryButton" Content="添加参考图" Click="PickPrimary_Click" />
                            <Button Content="清空参考图" Click="ClearMedia_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 参考音色 -->
                    <StackPanel x:Name="RefVoicePanel" Spacing="{StaticResource Space2}">
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="参考音色：wav/mp3，1-10s，按顺序对应参考图1/视频1，只取音色不看内容" />
                        <ListView x:Name="RefVoiceList" MaxHeight="120" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="{StaticResource Space2}" Padding="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Content="移除" FontSize="12"
                                                Tag="{Binding Index}" Click="RemoveRefVoice_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                            <Button x:Name="PickRefVoiceButton" Content="添加音色" Click="PickRefVoice_Click" />
                            <Button Content="清空音色" Click="ClearRefVoice_Click" />
                            <TextBlock x:Name="RefVoiceHint" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Text="仅 wan2.7-r2v 支持。" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 素材库：视频从这导入/裁切；参考图用上面的按钮 -->
            <Border Style="{StaticResource Card}">
                <controls:ClipBinPanel x:Name="Bin" HeaderText="素材库" />
            </Border>

            <!-- 参数 -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="{StaticResource Space4}" RowSpacing="{StaticResource Space3}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ComboBox x:Name="ModelCombo" Header="模型" HorizontalAlignment="Stretch"
                              SelectionChanged="Any_SelectionChanged">
                        <x:String>wan3.0-video-prime</x:String>
                        <x:String>wan3.0-video</x:String>
                        <x:String>wan2.7-videoedit</x:String>
                        <x:String>wan2.7-i2v</x:String>
                        <x:String>wan2.7-r2v</x:String>
                    </ComboBox>

                    <ComboBox x:Name="ResolutionCombo" Grid.Column="1" Header="分辨率"
                              HorizontalAlignment="Stretch" SelectionChanged="Any_SelectionChanged">
                        <x:String>480P</x:String>
                        <x:String>720P</x:String>
                        <x:String>1080P</x:String>
                    </ComboBox>

                    <ComboBox x:Name="RatioCombo" Grid.Row="1" Header="画幅"
                              HorizontalAlignment="Stretch" SelectionChanged="Any_SelectionChanged">
                        <x:String>adaptive</x:String>
                        <x:String>16:9</x:String>
                        <x:String>9:16</x:String>
                        <x:String>1:1</x:String>
                        <x:String>4:3</x:String>
                        <x:String>3:4</x:String>
                    </ComboBox>

                    <ComboBox x:Name="DurationCombo" Grid.Row="1" Grid.Column="1" Header="时长（秒）"
                              HorizontalAlignment="Stretch" SelectionChanged="Any_SelectionChanged">
                        <x:String>3</x:String>
                        <x:String>5</x:String>
                        <x:String>8</x:String>
                        <x:String>10</x:String>
                        <x:String>15</x:String>
                        <x:String>20</x:String>
                        <x:String>30</x:String>
                    </ComboBox>

                    <!-- API 平台：两家的域名和可用模型不同，这里给个一键切换 -->
                    <ComboBox x:Name="PlatformCombo" Grid.Row="2" Header="API 平台"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="PlatformCombo_SelectionChanged" />
                    <TextBlock x:Name="PlatformHint" Grid.Row="2" Grid.Column="1"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               VerticalAlignment="Bottom" Margin="0,0,0,4" />

                    <!-- 人物替换：时长由原视频决定，不给选 -->
                    <StackPanel x:Name="DurationAutoPanel" Grid.Row="1" Grid.Column="1"
                                Spacing="{StaticResource Space1}" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource CaptionText}" Text="时长（秒）" />
                        <TextBlock x:Name="DurationAutoText" FontSize="15" FontWeight="SemiBold"
                                   Text="按原视频" />
                        <TextBlock x:Name="DurationAutoHint" Style="{StaticResource CaptionText}" Text="" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 续接（内嵌在生成里） -->
            <Border Style="{StaticResource SubCard}">
                <StackPanel Spacing="{StaticResource Space2}">
                    <CheckBox x:Name="AnchorToggle" Content="衔接上一段（续接）"
                              Checked="AnchorToggle_Changed" Unchecked="AnchorToggle_Changed" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="模型单次上限 15s。要更长就把已生成结果当首片段（first_clip）接着写，每段都锚上一段的尾巴，接缝才不会跳。" />
                    <StackPanel x:Name="AnchorPanel" Spacing="{StaticResource Space2}" Visibility="Collapsed">
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="12" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                        <ComboBox x:Name="AnchorSourceCombo" Header="从哪段续接（已生成视频池）"
                                  HorizontalAlignment="Stretch" DisplayMemberPath="Title"
                                  SelectionChanged="AnchorSource_Changed" />
                        <NumberBox x:Name="AnchorTailBox" Header="取尾部秒数（2-10）"
                                   Minimum="2" Maximum="10" SmallChange="1"
                                   SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch"
                                   ValueChanged="AnchorTail_Changed" />
                        <TextBlock x:Name="AnchorHint" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 就绪提示 + 主操作 -->
            <StackPanel Spacing="{StaticResource Space3}">
                <TextBlock x:Name="ReadyHint" Style="{StaticResource BodyText}" />
                <Button x:Name="GenerateButton" Content="生成"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="160" HorizontalAlignment="Left"
                        Click="GenerateButton_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True">
                <InfoBar.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="8" />
                    </TransitionCollection>
                </InfoBar.Transitions>
            </InfoBar>

        </StackPanel>
    </ScrollViewer>
</Page>
