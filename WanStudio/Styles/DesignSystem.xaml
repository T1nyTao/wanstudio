<?xml version="1.0" encoding="utf-8"?>
<!--
    设计系统（全局资源）。

    为什么集中在这里：项目早期的样式散落在各页 Page.Resources 里，
    导致 UserControl 引用不到页面私有资源、直接把宿主页打挂（XamlParseException）。
    现在统一提到 App 级，任何页面/控件都能安全引用。

    令牌分五组：间距 / 字号 / 圆角 / 颜色 / 动效时长。
    改视觉先改这里，不要在各页里写魔法数字。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 间距：8pt 基准刻度 ============ -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">24</x:Double>
    <x:Double x:Key="Space6">32</x:Double>
    <x:Double x:Key="Space7">48</x:Double>

    <Thickness x:Key="PagePadding">32,28,32,40</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="CardPaddingCompact">14</Thickness>

    <!-- ============ 字号阶梯：1.25 比例，只用四级 ============ -->
    <x:Double x:Key="FontDisplay">30</x:Double>
    <x:Double x:Key="FontTitle">20</x:Double>
    <x:Double x:Key="FontBody">14</x:Double>
    <x:Double x:Key="FontCaption">12</x:Double>

    <!-- ============ 圆角 ============ -->
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- ============ 动效时长：短促、克制 ============ -->
    <Duration x:Key="DurFast">0:0:0.12</Duration>
    <Duration x:Key="DurBase">0:0:0.2</Duration>
    <Duration x:Key="DurSlow">0:0:0.32</Duration>

    <!-- ============ 排版 ============ -->
    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="38" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- 说明文字：唯一允许的「弱化」层级，别再用 Opacity 手调 -->
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- 强调数字/关键结论 -->
    <Style x:Key="MetricText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>

    <!-- ============ 卡片 ============ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- 次级卡片：用于卡片内再分组，靠底色区分而不是加边框 -->
    <Style x:Key="SubCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="{StaticResource CardPaddingCompact}" />
    </Style>

    <!-- 强调卡片：主路径操作区 -->
    <Style x:Key="AccentCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- ============ 页头 ============ -->
    <Style x:Key="PageHeader" TargetType="StackPanel">
        <Setter Property="Spacing" Value="{StaticResource Space2}" />
    </Style>

    <!-- ============ 微交互：卡片悬停 ============ -->
    <Style x:Key="HoverCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Transitions">
            <Setter.Value>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
